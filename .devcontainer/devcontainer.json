{
    "name": "Self-Balancing Cube Dev Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "vscode",
    // Make STLink debug and tty interfaces available to the devcontainer.
    "runArgs": [
        "--device-cgroup-rule=c 189:* rmw",
        "--device-cgroup-rule=c 166:* rmw",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges:true"
    ],
    // Allow hotplug access to the devices, but since the cgroup rules above
    // are not permissive, other devices will not be accessible to the 
    // devcontainer.
    "mounts": [
        "source=/dev,target=/dev,type=bind",
        "source=${localWorkspaceFolder}/.git,target=${containerWorkspaceFolder}/.git,type=bind,readonly"
    ],
    "features": {
        "ghcr.io/devcontainers-community/features/bazel:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "marus25.cortex-debug",
                "BazelBuild.vscode-bazel",
                "ms-python.python",
                "eamodio.gitlens"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "clangd.path": "clangd",
                "clangd.arguments": [
                    "--query-driver=/usr/bin/arm-none-eabi-g*",
                    "--background-index",
                    "--header-insertion=never"
                ],
                "C_Cpp.intelliSenseEngine": "disabled",
                "bazel.buildifierExecutable": "/usr/local/bin/buildifier"
            }
        }
    },
    "postCreateCommand": ""
}

