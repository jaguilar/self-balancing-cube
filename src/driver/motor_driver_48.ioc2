      "STMicroelectronics.thread_safe_libc.2.1.2$STMicroelectronics::Utility:STM32CubeMX2 Config:thread_safe_libc@1.1.0#ThreadSafeLibc Config": [
        {
          "index": 15,
          "instanceId": "5d6c9a19-5e33-4633-acde-d43dee09f8df",
          "entity": "unknown",
          "settings": {
            "parameters": {
              "info": {
                "description": "This utility enables thread-safe support for the C library on STM32. It provides lock integration for ARM (armlib), GCC/newlib, and IAR (DLib), with bare-metal or FreeRTOS locking strategies configured in stm32_lock.h. It protects malloc, other libc internals, and C++ static initialization. No direct user API is exposed.",
                "recommendation": "The generated code does not compile by default after STM32CubeMX2 code generation because the required runtime-library integration settings are not applied automatically. Additional manual toolchain updates are required: for IAR, enable thread support in library; for GCC, remove any explicit -lc option from the link flags. Check the Thread Safe LibC online documentation for the detailed post-generation steps needed to make the generated code build and run correctly."
              },
              "basic": {
                "locking_strategy": "FreeRTOSAllow"
              }
            }
          }
        }
      ],
