<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd" Dvendor="STMicroelectronics:13" Dname="STM32*">
  <vendor>STMicroelectronics</vendor>
  <name>thread_safe_libc</name>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <releases>
    <release version="2.0.0" date="2026-01-16">
      - First GPDSC template Model Release for thread_safe_libc
    </release>
  </releases>
  <conditions>
    
    <condition id="GCC">
    <description>nanolibc, usually linked by GCC compilers</description>
    <require Tcompiler="GCC"/>
  </condition>
  <condition id="ARMCC">
    <description>ARMlibc, usually linked by armclang compilers</description>
    <require Tcompiler="ARMCC"/>
  </condition>
  <condition id="IAR">
    <description>Dlib, usually linked by IAR compilers</description>
    <require Tcompiler="IAR"/>
  </condition>
    <condition id="ThreadSafeLibc Config">
      <description>selection of thread-safe locking strategy is required to use the component</description>
      <require Cclass="Utility" Cgroup="Thread-safe libc" Csub="libc" />
    </condition>
  </conditions>
  <components>
    <component generator="thread_safe_libc_mx2codegen" Cclass="Utility" Cgroup="STM32CubeMX2 Config" Csub="thread_safe_libc"  Cversion="1.1.0" condition="ThreadSafeLibc Config">
      <description>TO BE DEFINED</description>
      <Pre_Include_Global_h>
        #define STM32_THREAD_SAFE_FREERTOS_ALLOW_LOCKS (1U)
      </Pre_Include_Global_h>
      <files>
        <file category="other" name="mx_thread_safe_libc_license.md" />
      </files>
    </component>
  </components>
</package>